<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpsCore.UI.Views.AssetsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpsCore.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Assets" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" PlaceholderText="Search assets..." Width="300" HorizontalAlignment="Left" TextChanged="SearchBox_TextChanged"/>
            <Button Grid.Column="1" Content="+ Add Asset" Style="{StaticResource AccentButtonStyle}" Click="AddAsset_Click"/>
        </Grid>

        <Grid Grid.Row="2" Padding="12,8" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Name" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="1" Text="Type" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="2" Text="Status" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="3" Text="Location" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="4" Text="Assigned To" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="5" Text="Next Maintenance" FontWeight="Bold" Opacity="0.7"/>
        </Grid>

        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Assets, Mode=OneWay}"
                  IsItemClickEnabled="True" ItemClick="Asset_ItemClick">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Asset">
                    <Grid Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{x:Bind Name}"/>
                        <TextBlock Grid.Column="1" Text="{x:Bind AssetType.Name}"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind Status}"/>
                        <TextBlock Grid.Column="3" Text="{x:Bind Location}"/>
                        <TextBlock Grid.Column="4" Text="{x:Bind Employee.FirstName}"/>
                        <TextBlock Grid.Column="5" Text="{x:Bind NextMaintenanceDate}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

    </Grid>
</Page>