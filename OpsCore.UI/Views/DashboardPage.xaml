<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OpsCore.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpsCore.Core.Models"
    mc:Ignorable="d">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="24">

            <!-- Header -->
            <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"/>

            <!-- KPI Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Assets -->
                <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Total Assets" FontSize="14" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.TotalAssets, Mode=OneWay}" FontSize="36" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Active Assets -->
                <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Active Assets" FontSize="14" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.ActiveAssets, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="Green"/>
                    </StackPanel>
                </Border>

                <!-- Maintenance Due -->
                <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                    <StackPanel>
                        <TextBlock Text="Maintenance Due" FontSize="14" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.MaintenanceDue, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="Orange"/>
                    </StackPanel>
                </Border>

                <!-- Overdue -->
                <Border Grid.Column="3" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Overdue" FontSize="14" Opacity="0.7"/>
                        <TextBlock Text="{x:Bind ViewModel.OverdueAssets, Mode=OneWay}" FontSize="36" FontWeight="Bold" Foreground="Red"/>
                    </StackPanel>
                </Border>

            </Grid>

            <!-- Recent Activity -->
            <TextBlock Text="Recent Activity" FontSize="20" FontWeight="SemiBold"/>

            <ListView ItemsSource="{x:Bind ViewModel.RecentActivity, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ActivityLog">
                        <Grid Padding="0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind Asset.Name}"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind Action}"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind CreatedAt}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </StackPanel>
    </ScrollViewer>
</Page>