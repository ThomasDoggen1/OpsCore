<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="OpsCore.UI.Views.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpsCore.Core.Models"
    xmlns:converters="using:OpsCore.UI.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:MaintenanceStatusColorConverter x:Key="StatusColorConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Maintenance" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Column Headers -->
        <Grid Grid.Row="1" Padding="12,8" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Asset Name" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="1" Text="Last Maintenance" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="2" Text="Next Maintenance" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="3" Text="Status" FontWeight="Bold" Opacity="0.7"/>
            <TextBlock Grid.Column="4" Text=""/>
        </Grid>

        <TabView Grid.Row="2" IsAddTabButtonVisible="False">

            <TabViewItem Header="All">
                <ListView x:ConnectionId='23'                                                        >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='25' Padding="0,8"                                                                      >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='26' Grid.Column="0"                      Foreground="Black"/>
                                <TextBlock x:ConnectionId='27' Grid.Column="1"                                     Foreground="Black"/>
                                <TextBlock x:ConnectionId='28' Grid.Column="2"                                     Foreground="Black"/>
                                <TextBlock x:ConnectionId='29' Grid.Column="3"                        Foreground="Black"/>
                                <Button x:ConnectionId='30' Grid.Column="4" Content="Mark as Maintained"                                             Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem Header="Overdue">
                <ListView x:ConnectionId='16'                                                            >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='18' Padding="0,8" Background="#FFCCCC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='19' Grid.Column="0"                      Foreground="Black"/>
                                <TextBlock x:ConnectionId='20' Grid.Column="1"                                     Foreground="Black"/>
                                <TextBlock x:ConnectionId='21' Grid.Column="2"                                     Foreground="Black"/>
                                <TextBlock Grid.Column="3" Text="Overdue" Foreground="Red"/>
                                <Button x:ConnectionId='22' Grid.Column="4" Content="Mark as Maintained"                                             Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem Header="Due Soon">
                <ListView x:ConnectionId='9'                                                            >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='11' Padding="0,8" Background="#FFE5CC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='12' Grid.Column="0"                      Foreground="Black"/>
                                <TextBlock x:ConnectionId='13' Grid.Column="1"                                     Foreground="Black"/>
                                <TextBlock x:ConnectionId='14' Grid.Column="2"                                     Foreground="Black"/>
                                <TextBlock Grid.Column="3" Text="Due Soon" Foreground="Orange"/>
                                <Button x:ConnectionId='15' Grid.Column="4" Content="Mark as Maintained"                                             Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

            <TabViewItem Header="Ok">
                <ListView x:ConnectionId='2'                                                       >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='4' Padding="0,8" Background="#CCFFCC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="160"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='5' Grid.Column="0"                      Foreground="Black"/>
                                <TextBlock x:ConnectionId='6' Grid.Column="1"                                     Foreground="Black"/>
                                <TextBlock x:ConnectionId='7' Grid.Column="2"                                     Foreground="Black"/>
                                <TextBlock Grid.Column="3" Text="Ok" Foreground="Green"/>
                                <Button x:ConnectionId='8' Grid.Column="4" Content="Mark as Maintained"                                             Foreground="Black"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>

        </TabView>
    </Grid>
</Page>

