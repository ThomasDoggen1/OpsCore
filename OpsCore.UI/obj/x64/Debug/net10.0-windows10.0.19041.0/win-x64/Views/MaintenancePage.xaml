<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="OpsCore.UI.Views.MaintenancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:OpsCore.Core.Models"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Maintenance" FontSize="28" FontWeight="Bold" Margin="0,0,0,16"/>

        <!-- Filter Tabs -->
        <TabView Grid.Row="1" IsAddTabButtonVisible="False" Margin="0,0,0,16">
            <TabViewItem Header="Overdue">
                <ListView x:ConnectionId='12'                                                            >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='14' Padding="0,8" Background="#FFCCCC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='15' Grid.Column="0"                     />
                                <TextBlock x:ConnectionId='16' Grid.Column="1"                                    />
                                <TextBlock Grid.Column="2" Text="Overdue" Foreground="Red"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
            <TabViewItem Header="Due Soon">
                <ListView x:ConnectionId='7'                                                            >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='9' Padding="0,8" Background="#FFE5CC">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='10' Grid.Column="0"                     />
                                <TextBlock x:ConnectionId='11' Grid.Column="1"                                    />
                                <TextBlock Grid.Column="2" Text="Due Soon" Foreground="Orange"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
            <TabViewItem Header="Ok">
                <ListView x:ConnectionId='2'                                                       >
                    <ListView.ItemTemplate>
                        <DataTemplate                          >
                            <Grid x:ConnectionId='4' Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:ConnectionId='5' Grid.Column="0"                     />
                                <TextBlock x:ConnectionId='6' Grid.Column="1"                                    />
                                <TextBlock Grid.Column="2" Text="Ok" Foreground="Green"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </TabViewItem>
        </TabView>

    </Grid>
</Page>

